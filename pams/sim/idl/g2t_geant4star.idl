/* $Id: g2t_geant4star.idl,v 1.0 2026/05/13  yelfeky $
 * $Log$
 *
 * g2t_geant4star.idl - Configuration table for geant4star simulation
 *
 * This table persists the geant4star configuration parameters in the output
 * .geant.root file. Downstream makers can check for its presence to distinguish
 * geant4star simulations from legacy starsim simulations.
 *
 * If g2t_geant4star is present in the geant.root file:
 *     - Simulation was run with geant4star
 *     - Configuration parameters can be accessed from this table
 *
 * If g2t_geant4star is absent:
 *     - Simulation was run with starsim
 *     - Use default/legacy configuration values
 *
 */

struct g2t_geant4star {
    /* Physics engine and mode */
    char      application_engine[6]; /* Application mode: G3=GEANT3, G4=Geant4, multi=mixed G3/G4 mode */
    char      all_engine[6];         /* In multi-engine mode, selects the default engine for all subsystems */
    char      wcal_engine[6];        /* WCAL engine: "G3" or "G4" */
    char      hcal_engine[6];        /* HCAL engine: "G3" or "G4" */
    char      physics_list[32];      /* Geant4 physics list name (e.g., "FTFP_BERT") */
 
    /* Physics cuts (energy in GeV) */
    float     cutgam;              /* Minimum photon energy for track propagation         */
    float     cutele;              /* Minimum electron energy for track propagation       */
    float     cuthad;              /* Minimum charged hadron energy for track propagation */
    float     cutneu;              /* Minimum neutral hadron energy for track propagation */
    float     cutmuo;              /* Minimum muon energy for track propagation           */
    float     bcute;               /* Cut for electron brem             */
    float     bcutm;               /* Cut for muon brem                 */
    float     dcute;               /* Cut for electron delta rays       */
    float     dcutm;               /* Cut for muon delta rays           */
    float     ppcutm;              /* Cut for e+e- production by muons  */
    float     tofmax;              /* Maximum time-of-flight for tracks */
 
    /* Physics process flags (1=enabled, 0=disabled) */
    long      pair;                       /* Enable/disable pair production           */
    long      comp;                       /* Enable/disable compton scattering        */
    long      phot;                       /* Enable/disable photoelectric effect      */
    long      pfis;                       /* Enable/disable photo fission"            */
    long      dray;                       /* Enable/disable delta rays                */
    long      anni;                       /* Enable/disable positron annihilation     */
    long      brem;                       /* Enable/disable bremstrahlung             */
    long      hadr;                       /* Enable/disable hadronic interactions     */
    long      munu;                       /* Enable/disable muon-nucleus interactions */
    long      dcay;                       /* Enable/disable decays                    */
    long      loss;                       /* Energy loss mode"                        */
    long      muls;                       /* Multiple scattering                      */
    long      ckov;                       /* Cherenkov radiation                      */
    long      rayl;                       /* Rayleigh scattering                      */
    long      labs;                       /* Absorption of ckov photons               */
    long      sync;                       /* Synchrotron radiation                    */
       
    /* Magnetic field */
    float     field;                      /* Magnetic field strength [kG] */
 
    /* Random number seed */
    long      random_seed;                /* RNG IS LISTNING */
 
    /* Application limits (in cm) */
    float     zmax;                /* Universe maximum z */
    float     rmax;                /* Universe maximum radius */
 
    /* Primary vertex */
    float     vertex_x;            /* Primary vertex x [cm]     */
    float     vertex_y;            /* Primary vertex y [cm]     */
    float     vertex_z;            /* Primary vertex z [cm]     */
    float     vertex_sigmax;       /* Primary vertex width [cm] */    
    float     vertex_sigmay;       /* Primary vertex width [cm] */    
    float     vertex_sigmaz;       /* Primary vertex width [cm] */    
 
    /* Stepping/Punchout options (cm) */
    long      punchout_stop;       /* Punchout action: 0=no action, 1=stop, 2=stop+reinject */
    float     punchout_rmin;       /* Min radius for punchout logic */
    float     punchout_zmin;       /* Min Z for punchout logic */
 
    /* Scoring limits for truth tables */
    float     scoring_rmax;        /* Maxium secondary production radius to enter truth tables */
    float     scoring_zmax;        /* Maximum secondary production z to enter truth tables     */
    float     scoring_emin;        /* Minimum secondary energy to enter truth tables           */
  
    /* Embedding mode */
    long      embedding_mode;      /* 0=off, otherwise embedding mode */
 
    /* Run number */
    long      run_number;          /* Run number from simulation */
};
 
